#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 20

typedef struct
{
    char nome[30];
    int vezes;
    float anterior;
    float atual;
} Exercicio;

int compNomes(const void *a, const void *b);
int compVolume(const void *a, const void *b);
float calcularVolume(int series, int reps, float carga);
void cadastrarExercicio(Exercicio *v, int *num);
void registrarTreino(Exercicio *v, int num);
void imprimirEvolucao(const Exercicio *v, int num);
void exibirNome(Exercicio *v, int num);
void exibirVolume(Exercicio *v, int num);
void salvar(const Exercicio *v, int num);
int carregar(Exercicio *v);
void menu(Exercicio *v, int *num);


int main() {
    Exercicio exercicios[MAX];
    int num;

    num = carregar(exercicios);
    menu(exercicios, &num);
    salvar(exercicios, num);

    return 0;
}

int compNomes(const void *a, const void *b)
{
    const Exercicio *p1 = (const Exercicio *)a;
    const Exercicio *p2 = (const Exercicio *)b;
    return strcmp(p1->nome, p2->nome);
}

int compVolume(const void *a, const void *b)
{
    const Exercicio *p1 = (const Exercicio *)a;
    const Exercicio *p2 = (const Exercicio *)b;
    if(p2->atual > p1->atual) {
        return 1;
    }
    if(p2->atual < p1->atual) {
        return -1;
    }
    return 0;
}

float calcularVolume(int series, int reps, float carga) {
    if(series == 0) {
        return 0;
    }
    return reps * carga + calcularVolume(series - 1, reps, carga);
}

void cadastrarExercicio(Exercicio *v, int *num) {
    if(*num >= MAX) {
        printf("\nLimite de exercicios atingido");
        return;
    }
    getchar();
    printf("\nDigite o nome do exercicio (limite de 30 caracteres): ");
    fgets(v[*num].nome, sizeof(v[*num].nome), stdin);
    v[*num].nome[strcspn(v[*num].nome, "\n")] = '\0';
    v[*num].vezes = 0;
    v[*num].anterior = 0;
    v[*num].atual = 0;
    (*num)++;
}

void registrarTreino(Exercicio *v, int num) {
    int i, escolha, series, reps;
    float carga;

    if(num == 0) {
        printf("\nCadastre um exercicio primeiro");
        return;
    }

    do {
        printf("\n\n==== ESCOLHA O EXERCICIO ====");
        for(i = 0; i < num; i++) {
            printf("\n%d - %s", i + 1, v[i].nome);
        }
        printf("\n0 - Terminar treino");
        printf("\nEscolha: ");
        scanf("%d", &escolha);

        if(escolha >= 1 && escolha <= num) {
            i = escolha - 1;
            printf("\n---- %s ----", v[i].nome);
            printf("\nSeries realizadas: ");
            scanf("%d", &series);
            printf("Repeticoes por serie: ");
            scanf("%d", &reps);
            printf("Carga em kg: ");
            scanf("%f", &carga);

            v[i].anterior = v[i].atual;
            v[i].atual = calcularVolume(series, reps, carga);
            v[i].vezes++;
        }
        else if(escolha != 0) {
            printf("\nOpcao invalida");
        }
    } while(escolha != 0);
}

void imprimirEvolucao(const Exercicio *v, int num) {
    for(int i = 0; i < num; i++) {
        printf("\n%-30s", v[i].nome);

        if(v[i].vezes == 0) {
            printf(" sem treino registrado");
        }
        else if(v[i].vezes == 1) {
            printf(" %.1f kg - referencia inicial", v[i].atual);
        }
        else if(v[i].atual > v[i].anterior) {
            printf(" %.1f -> %.1f kg: aumento", v[i].anterior, v[i].atual);
        }
        else if(v[i].atual < v[i].anterior) {
            printf(" %.1f -> %.1f kg: reducao", v[i].anterior, v[i].atual);
        }
        else {
            printf(" %.1f -> %.1f kg: manutencao", v[i].anterior, v[i].atual);
        }
    }
}

void exibirNome(Exercicio *v, int num) {
    qsort(v, num, sizeof(Exercicio), compNomes);

    printf("\n==== EVOLUCAO (ORDEM ALFABETICA) ====");
    imprimirEvolucao(v, num);
}

void exibirVolume(Exercicio *v, int num) {
    qsort(v, num, sizeof(Exercicio), compVolume);

    printf("\n==== EVOLUCAO (POR VOLUME) ====");
    imprimirEvolucao(v, num);
}

void salvar(const Exercicio *v, int num) {
    FILE *f = fopen("treinos.txt", "w");
    int i;

    if(f == NULL) {
        printf("\nErro ao salvar o arquivo");
        return;
    }

    fprintf(f, "%d\n", num);
    for(i = 0; i < num; i++) {
        fprintf(f, "%s\n%d %.2f %.2f\n", v[i].nome, v[i].vezes, v[i].anterior, v[i].atual);
    }
    fclose(f);
}

int carregar(Exercicio *v) {
    FILE *f = fopen("treinos.txt", "r");
    int i, num = 0;

    if(f == NULL) {
        return 0;
    }

    fscanf(f, "%d", &num);
    if(num > MAX) {
        num = MAX;
    }
    for(i = 0; i < num; i++) {
        fscanf(f, " %29[^\n] %d %f %f", v[i].nome, &v[i].vezes, &v[i].anterior, &v[i].atual);
    }
    fclose(f);
    return num;
}

void menu(Exercicio *v, int *num) {
    int opcao;

    do {
        printf("\n\n==== GERENCIADOR DE TREINOS ====");
        printf("\n1 - Cadastrar exercicio");
        printf("\n2 - Registrar treino");
        printf("\n3 - Evolucao por ordem alfabetica");
        printf("\n4 - Evolucao por volume");
        printf("\n0 - Sair");
        printf("\nEscolha: ");
        scanf("%d", &opcao);

        switch(opcao) {
            case 1:
                cadastrarExercicio(v, num);
                break;
            case 2:
                registrarTreino(v, *num);
                break;
            case 3:
                exibirNome(v, *num);
                break;
            case 4:
                exibirVolume(v, *num);
                break;
            case 0:
                printf("\nEncerrando...");
                break;
            default:
                printf("\nOpcao invalida");
        }

    } while(opcao != 0);
}
